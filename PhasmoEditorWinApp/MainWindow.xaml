<Window x:Class="PhasmoEditor.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:PhasmoEditor"
 xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
 Title="PhasmoEditor 3.0" Icon="phasmoeditorlogo.ico" Width="1120" Height="880" MinWidth="960" MinHeight="730"
 WindowStyle="None" ResizeMode="CanResize" Background="#0D1312"
 Foreground="#EEF3EF" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
 WindowStartupLocation="CenterScreen" UseLayoutRounding="True">
 <shell:WindowChrome.WindowChrome>
  <shell:WindowChrome CaptionHeight="54" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="18" UseAeroCaptionButtons="False"/>
 </shell:WindowChrome.WindowChrome>
 <Window.Resources><local:Localization x:Key="Strings"/>
  <local:SaveDisplayConverter x:Key="SaveDisplay"/>
  <SolidColorBrush x:Key="Muted" Color="#93A39A"/>
  <SolidColorBrush x:Key="Accent" Color="#B9D7BC"/>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#EEF3EF"/></Style>
  <Style x:Key="Eyebrow" TargetType="TextBlock">
   <Setter Property="FontFamily" Value="Cascadia Mono, Consolas"/>
   <Setter Property="FontSize" Value="10"/><Setter Property="Foreground" Value="#94AA9B"/>
  </Style>
  <Style x:Key="Card" TargetType="Border">
   <Setter Property="Background" Value="#17201D"/><Setter Property="BorderBrush" Value="#2B3730"/>
   <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="18"/>
   <Setter Property="Padding" Value="22"/>
  </Style>
  <Style TargetType="Button">
   <Setter Property="Background" Value="#25312B"/><Setter Property="Foreground" Value="#E3EBE4"/>
   <Setter Property="BorderBrush" Value="#3A483E"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="16,10"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="Template"><Setter.Value>
    <ControlTemplate TargetType="Button">
     <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
      BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}">
      <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
     </Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.8"/></Trigger>
      <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.6"/></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.35"/></Trigger>
      <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#D2E8D3"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate>
   </Setter.Value></Setter>
  </Style>
  <Style x:Key="QuietButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="#344139"/>
  </Style>
  <Style x:Key="CaptionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
   <Setter Property="Padding" Value="12,4"/><Setter Property="FontWeight" Value="Normal"/>
   <Setter Property="Foreground" Value="#98A99E"/><Setter Property="FontSize" Value="17"/>
   <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
  </Style>
  <Style x:Key="EnglishSwitch" TargetType="Button" BasedOn="{StaticResource QuietButton}">
   <Setter Property="Padding" Value="10,5"/><Setter Property="FontSize" Value="11"/>
   <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
   <Style.Triggers>
    <DataTrigger Binding="{Binding Language, Source={StaticResource Strings}}" Value="en">
     <Setter Property="Background" Value="#B9D7BC"/><Setter Property="Foreground" Value="#182D1D"/>
    </DataTrigger>
   </Style.Triggers>
  </Style>
  <Style x:Key="RussianSwitch" TargetType="Button" BasedOn="{StaticResource QuietButton}">
   <Setter Property="Padding" Value="10,5"/><Setter Property="FontSize" Value="11"/>
   <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
   <Style.Triggers>
    <DataTrigger Binding="{Binding Language, Source={StaticResource Strings}}" Value="ru">
     <Setter Property="Background" Value="#B9D7BC"/><Setter Property="Foreground" Value="#182D1D"/>
    </DataTrigger>
   </Style.Triggers>
  </Style>
  <Style TargetType="TextBox">
   <Setter Property="Background" Value="#101813"/><Setter Property="Foreground" Value="#F0F5EF"/>
   <Setter Property="CaretBrush" Value="#C1DCC1"/><Setter Property="SelectionBrush" Value="#56745E"/>
   <Setter Property="BorderBrush" Value="#35483A"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="14,0"/><Setter Property="FontSize" Value="27"/>
   <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI"/>
   <Setter Property="Height" Value="64"/>
   <Setter Property="VerticalContentAlignment" Value="Center"/>
   <Setter Property="Template"><Setter.Value>
    <ControlTemplate TargetType="TextBox">
     <Border x:Name="InputBorder" CornerRadius="11" Background="{TemplateBinding Background}"
      BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
      <ScrollViewer x:Name="PART_ContentHost" Margin="0" Padding="0"/>
     </Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="InputBorder" Property="BorderBrush" Value="#B9D7BC"/></Trigger>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="InputBorder" Property="Background" Value="#17231A"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate>
   </Setter.Value></Setter>
  </Style>
  <Style TargetType="ScrollBar">
   <Setter Property="Width" Value="7"/>
   <Setter Property="Background" Value="Transparent"/>
   <Setter Property="Template"><Setter.Value>
    <ControlTemplate TargetType="ScrollBar">
     <Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="{TemplateBinding Orientation}">
      <Track.DecreaseRepeatButton>
       <RepeatButton x:Name="DecreaseButton" Command="ScrollBar.PageUpCommand" Focusable="False">
        <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template>
       </RepeatButton>
      </Track.DecreaseRepeatButton>
      <Track.Thumb>
       <Thumb>
        <Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#49604F" CornerRadius="3" Margin="1"/></ControlTemplate></Thumb.Template>
       </Thumb>
      </Track.Thumb>
      <Track.IncreaseRepeatButton>
       <RepeatButton x:Name="IncreaseButton" Command="ScrollBar.PageDownCommand" Focusable="False">
        <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template>
       </RepeatButton>
      </Track.IncreaseRepeatButton>
     </Track>
     <ControlTemplate.Triggers>
      <Trigger Property="Orientation" Value="Horizontal">
       <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
       <Setter TargetName="DecreaseButton" Property="Command" Value="ScrollBar.PageLeftCommand"/>
       <Setter TargetName="IncreaseButton" Property="Command" Value="ScrollBar.PageRightCommand"/>
      </Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate>
   </Setter.Value></Setter>
   <Style.Triggers>
    <Trigger Property="Orientation" Value="Horizontal"><Setter Property="Width" Value="Auto"/><Setter Property="Height" Value="7"/></Trigger>
   </Style.Triggers>
  </Style>
  <Style TargetType="ComboBoxItem">
   <Setter Property="Foreground" Value="#E3EBE4"/><Setter Property="Padding" Value="12,9"/>
   <Setter Property="Template"><Setter.Value>
    <ControlTemplate TargetType="ComboBoxItem">
     <Border x:Name="ItemSurface" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="6">
      <ContentPresenter/>
     </Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemSurface" Property="Background" Value="#354A3A"/></Trigger>
      <Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemSurface" Property="Background" Value="#2B3C30"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate>
   </Setter.Value></Setter>
  </Style>
  <Style TargetType="ComboBox">
   <Setter Property="Foreground" Value="#E3EBE4"/><Setter Property="MinHeight" Value="40"/>
   <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
   <Setter Property="ToolTip" Value="{Binding SelectedItem, RelativeSource={RelativeSource Self}}"/>
   <Setter Property="ItemTemplate">
    <Setter.Value><DataTemplate><TextBlock Foreground="#D5E1D7"><TextBlock.Text><MultiBinding Converter="{StaticResource SaveDisplay}"><Binding/><Binding Path="Language" Source="{StaticResource Strings}"/></MultiBinding></TextBlock.Text></TextBlock></DataTemplate></Setter.Value>
   </Setter>
   <Setter Property="Template"><Setter.Value>
    <ControlTemplate TargetType="ComboBox">
     <Grid>
      <ToggleButton x:Name="DropButton" Background="#101813" BorderBrush="#35483A" Focusable="False"
       IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
       <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
        <Border x:Name="DropSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
         BorderThickness="1" CornerRadius="10" Padding="13,10">
         <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="20"/></Grid.ColumnDefinitions>
          <TextBlock Foreground="#D5E1D7"
           FontFamily="Cascadia Mono, Consolas" FontSize="11" TextTrimming="CharacterEllipsis"><TextBlock.Text><MultiBinding Converter="{StaticResource SaveDisplay}"><Binding Path="SelectedItem" RelativeSource="{RelativeSource AncestorType=ComboBox}"/><Binding Path="Language" Source="{StaticResource Strings}"/></MultiBinding></TextBlock.Text></TextBlock>
          <TextBlock Grid.Column="1" Foreground="#9FB5A5" Text="⌄" HorizontalAlignment="Right"/>
         </Grid>
        </Border>
        <ControlTemplate.Triggers>
         <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="DropSurface" Property="BorderBrush" Value="#819D88"/></Trigger>
         <Trigger Property="IsChecked" Value="True"><Setter TargetName="DropSurface" Property="BorderBrush" Value="#B9D7BC"/></Trigger>
        </ControlTemplate.Triggers>
       </ControlTemplate></ToggleButton.Template>
      </ToggleButton>
      <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
       PlacementTarget="{Binding ElementName=DropButton}" AllowsTransparency="True" Focusable="False">
       <Border Background="#1B2920" BorderBrush="#49624F" BorderThickness="1" CornerRadius="10" Padding="4"
        Width="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
        <ScrollViewer MaxHeight="220" HorizontalScrollBarVisibility="Auto"><ItemsPresenter/></ScrollViewer>
       </Border>
      </Popup>
     </Grid>
     <ControlTemplate.Triggers>
      <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="DropButton" Property="BorderBrush" Value="#B9D7BC"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate>
   </Setter.Value></Setter>
  </Style>
 </Window.Resources>

 <Border CornerRadius="18" BorderBrush="#344038" BorderThickness="1" ClipToBounds="True">
  <Border.Background>
   <LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#18241F"/><GradientStop Color="#0B1110" Offset="0.8"/></LinearGradientBrush>
  </Border.Background>
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="54"/><RowDefinition/></Grid.RowDefinitions>
   <Grid Margin="22,0,16,0">
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
     <Image Source="phasmoeditorlogo.ico" Width="22" Height="22" Margin="0,0,10,0"/>
     <TextBlock Text="PHASMOEDITOR" FontSize="11" FontWeight="SemiBold" Foreground="#C4D2C7"/>
     <TextBlock Text=" /  3.0" FontFamily="Consolas" FontSize="11" Foreground="#647C6D" Margin="8,0,0,0"/>
    </StackPanel>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
     <Button x:Name="EnglishButton" Content="EN" Style="{StaticResource EnglishSwitch}" Click="English_Click" Margin="0,0,4,0"/>
     <Button x:Name="RussianButton" Content="RU" Style="{StaticResource RussianSwitch}" Click="Russian_Click" Margin="0,0,14,0"/>
     <Button Style="{StaticResource CaptionButton}" Content="−" Click="Minimize_Click" ToolTip="{Binding [Minimize], Source={StaticResource Strings}}"/>
     <Button Style="{StaticResource CaptionButton}" Content="□" Click="Maximize_Click" ToolTip="{Binding [Maximize], Source={StaticResource Strings}}"/>
     <Button Style="{StaticResource CaptionButton}" Content="×" Click="Close_Click" ToolTip="{Binding [Close], Source={StaticResource Strings}}"/>
    </StackPanel>
   </Grid>
   <Grid Grid.Row="1">
    <Grid.ColumnDefinitions><ColumnDefinition Width="192"/><ColumnDefinition/></Grid.ColumnDefinitions>

    <Border BorderBrush="#29382E" BorderThickness="0,1,1,0" Background="#111A16">
     <Grid Margin="20,28,20,22">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <StackPanel>
       <Border Width="54" Height="54" CornerRadius="16" HorizontalAlignment="Left" BorderBrush="#53705A" BorderThickness="1">
        <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#3D5742"/><GradientStop Color="#1A2B20" Offset="1"/></LinearGradientBrush></Border.Background>
        <Image Source="phasmoeditorlogo.ico" Margin="7" RenderOptions.BitmapScalingMode="HighQuality"/>
       </Border>
       <TextBlock Text="Phasmo&#10;Editor" FontSize="24" FontWeight="SemiBold" LineHeight="29" Margin="0,18,0,8"/>
       <TextBlock Text="{Binding [Tagline], Source={StaticResource Strings}}" Foreground="#91A698" FontSize="12" LineHeight="19"/>
      </StackPanel>
      <StackPanel Grid.Row="1" Margin="0,32,0,0">
       <TextBlock Text="{Binding [Workspace], Source={StaticResource Strings}}" Style="{StaticResource Eyebrow}" Margin="4,0,0,12"/>
       <Button Content="{Binding [NavSave], Source={StaticResource Strings}}" Click="NavigateSave_Click" Style="{StaticResource QuietButton}" HorizontalContentAlignment="Left" Margin="0,0,0,8"/>
       <Button Content="{Binding [NavProgress], Source={StaticResource Strings}}" Click="NavigateProgress_Click" Style="{StaticResource QuietButton}" Margin="0,0,0,8"/>
       <Button Content="{Binding [NavBackups], Source={StaticResource Strings}}" Click="NavigateBackups_Click" Style="{StaticResource QuietButton}"/>
      </StackPanel>
      <StackPanel Grid.Row="3">
       <Grid Height="44" Margin="0,0,0,14" ClipToBounds="True" Opacity="0.45">
        <Path Data="M 0,22 L 26,22 29,18 32,24 37,22 49,22 53,9 58,36 63,17 67,22 88,22 92,19 95,24 100,22 152,22"
         Stroke="#A9D2AC" StrokeThickness="1" Stretch="Fill" VerticalAlignment="Center"/>
       </Grid>
       <Border BorderBrush="#2F4335" BorderThickness="0,1,0,0" Padding="0,16,0,0">
        <StackPanel>
         <TextBlock Text="{Binding [FieldNotes], Source={StaticResource Strings}}" Style="{StaticResource Eyebrow}" Margin="0,0,0,8"/>
         <TextBlock Text="{Binding [BackupNote], Source={StaticResource Strings}}" Foreground="#82988A" FontSize="11" LineHeight="17"/>
        </StackPanel>
       </Border>
      </StackPanel>
     </Grid>
    </Border>

    <ScrollViewer x:Name="WorkspaceScroll" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <StackPanel Margin="30,22,30,18">
      <Grid Margin="0,0,0,22">
       <StackPanel>
        <TextBlock Text="{Binding [Subtitle], Source={StaticResource Strings}}" Style="{StaticResource Eyebrow}" Margin="0,0,0,8"/>
        <TextBlock Text="{Binding [Heading], Source={StaticResource Strings}}" FontSize="28" FontWeight="SemiBold"/>
        <TextBlock Text="{Binding [Description], Source={StaticResource Strings}}" Foreground="#91A698" Margin="0,7,0,0"/>
       </StackPanel>
       <Border HorizontalAlignment="Right" VerticalAlignment="Top" CornerRadius="9" Background="#25382A" Padding="10,6" Margin="0,4,0,0">
        <TextBlock Text="{Binding [LocalFile], Source={StaticResource Strings}}" Style="{StaticResource Eyebrow}" Foreground="#B9D7BC"/>
       </Border>
      </Grid>

      <Border x:Name="SaveSection" Style="{StaticResource Card}" Margin="0,0,0,14">
       <StackPanel>
        <Grid Margin="0,0,0,15">
         <StackPanel Orientation="Horizontal"><TextBlock Text="01" Style="{StaticResource Eyebrow}" VerticalAlignment="Center" Margin="0,0,12,0"/>
          <TextBlock Text="{Binding [SaveFile], Source={StaticResource Strings}}" FontSize="17" FontWeight="SemiBold"/></StackPanel>
         <Button Content="{Binding [Reload], Source={StaticResource Strings}}" Click="Reload_Click" Style="{StaticResource QuietButton}" HorizontalAlignment="Right" Padding="10,6" FontSize="11"/>
        </Grid>
        <Grid>
         <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
         <ComboBox x:Name="Candidates" SelectionChanged="Candidates_SelectionChanged" ToolTip="{Binding [FoundSaves], Source={StaticResource Strings}}" Margin="0,0,10,0"/>
         <Button Grid.Column="1" Content="{Binding [Discover], Source={StaticResource Strings}}" Click="Discover_Click" Margin="0,0,8,0"/>
         <Button Grid.Column="2" Content="{Binding [Browse], Source={StaticResource Strings}}" Click="Browse_Click" Style="{StaticResource QuietButton}"/>
        </Grid>
        <TextBlock x:Name="PathLabel" Text="{Binding [NoSelection], Source={StaticResource Strings}}" Foreground="#8DA192" FontFamily="Consolas"
         FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,10,0,0" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
       </StackPanel>
      </Border>

      <Border x:Name="ProgressSection" Style="{StaticResource Card}" Margin="0,0,0,14">
       <StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,18"><TextBlock Text="02" Style="{StaticResource Eyebrow}" VerticalAlignment="Center" Margin="0,0,12,0"/>
         <TextBlock Text="{Binding [Profile], Source={StaticResource Strings}}" FontSize="17" FontWeight="SemiBold"/></StackPanel>
        <Grid>
         <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
         <StackPanel Margin="0,0,12,0">
          <TextBlock Text="{Binding [Money], Source={StaticResource Strings}}" Foreground="#ADBEB1" Margin="0,0,0,9"/>
          <TextBox x:Name="MoneyInput" AutomationProperties.Name="{Binding [Money], Source={StaticResource Strings}}" ToolTip="{Binding [MoneyHint], Source={StaticResource Strings}}"/>
          <TextBlock x:Name="MoneyCurrent" Text="{Binding [CurrentEmpty], Source={StaticResource Strings}}" FontSize="11" Foreground="#8DA192" Margin="2,8,0,0"/>
         </StackPanel>
         <StackPanel Grid.Column="1" Margin="0,0,12,0">
          <TextBlock Text="{Binding [Level], Source={StaticResource Strings}}" Foreground="#ADBEB1" Margin="0,0,0,9"/>
          <TextBox x:Name="LevelInput" AutomationProperties.Name="{Binding [Level], Source={StaticResource Strings}}"/>
          <TextBlock x:Name="LevelCurrent" Text="{Binding [CurrentEmpty], Source={StaticResource Strings}}" FontSize="11" Foreground="#8DA192" Margin="2,8,0,0"/>
         </StackPanel>
         <StackPanel Grid.Column="2">
          <TextBlock Text="{Binding [Prestige], Source={StaticResource Strings}}" Foreground="#ADBEB1" Margin="0,0,0,9"/>
          <TextBox x:Name="PrestigeInput" AutomationProperties.Name="{Binding [Prestige], Source={StaticResource Strings}}"/>
          <TextBlock x:Name="PrestigeCurrent" Text="{Binding [CurrentEmpty], Source={StaticResource Strings}}" FontSize="11" Foreground="#8DA192" Margin="2,8,0,0"/>
         </StackPanel>
        </Grid>
        <Grid Margin="0,20,0,0">
         <TextBlock Text="{Binding [CloudNote], Source={StaticResource Strings}}" FontSize="11" Foreground="#A8AE96" VerticalAlignment="Center" LineHeight="17"/>
         <Button x:Name="SaveButton" Content="{Binding [Save], Source={StaticResource Strings}}" Click="Save_Click" IsEnabled="False"
          Background="#B9D7BC" Foreground="#182D1D" BorderBrush="#D0E6D1" HorizontalAlignment="Right" Padding="18,12"/>
        </Grid>
       </StackPanel>
      </Border>

      <Border x:Name="BackupsSection" Style="{StaticResource Card}" Margin="0,0,0,16">
       <StackPanel>
        <Grid Margin="0,0,0,14">
         <StackPanel Orientation="Horizontal"><TextBlock Text="03" Style="{StaticResource Eyebrow}" VerticalAlignment="Center" Margin="0,0,12,0"/>
          <TextBlock Text="{Binding [Backups], Source={StaticResource Strings}}" FontSize="17" FontWeight="SemiBold"/></StackPanel>
         <TextBlock Text="{Binding [BackupsHint], Source={StaticResource Strings}}" Foreground="#91A698" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </Grid>
        <ComboBox x:Name="BackupList" ToolTip="{Binding [SelectBackup], Source={StaticResource Strings}}" Margin="0,0,0,12"/>
        <StackPanel Orientation="Horizontal">
         <Button Content="{Binding [Restore], Source={StaticResource Strings}}" Click="Restore_Click"/>
         <Button Content="{Binding [OpenFolder], Source={StaticResource Strings}}" Click="OpenBackups_Click" Style="{StaticResource QuietButton}" Margin="10,0,0,0"/>
        </StackPanel>
       </StackPanel>
      </Border>

      <Border Background="#111B15" BorderBrush="#2A3C2F" BorderThickness="1" CornerRadius="12" Padding="14,12">
       <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <TextBlock Text="○" Foreground="#A7CBAA" FontSize="15"/>
        <TextBlock x:Name="Status" Grid.Column="1" Text="{Binding [Welcome], Source={StaticResource Strings}}"
         Foreground="#9EB4A4" FontSize="11" TextWrapping="Wrap" LineHeight="17"/>
       </Grid>
      </Border>
     </StackPanel>
    </ScrollViewer>
   </Grid>
  </Grid>
 </Border>
</Window>
